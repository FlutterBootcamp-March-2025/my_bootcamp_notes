rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow access to user's own notes only
    match /Notes/{userId} {
      // Only allow access if the user is authenticated and the userId matches their auth ID
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Allow access to the user_notes subcollection with the same authentication check
      match /user_notes/{noteId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        // Validate data for create and update operations
        allow create: if request.resource.data.keys().hasAll(['title', 'note', 'createdAt']) &&
                        request.resource.data.title is string &&
                        request.resource.data.note is string &&
                        request.resource.data.createdAt is number;

        allow update: if request.resource.data.keys().hasAll(['title', 'note', 'createdAt']) &&
                        request.resource.data.title is string &&
                        request.resource.data.note is string &&
                        request.resource.data.createdAt is number;
      }
    }

    // Deny access to all other documents by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
